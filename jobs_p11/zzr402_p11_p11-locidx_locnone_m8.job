# Labo jouet PHASE 11 — métadonnées par ROTATION sur les clés banque (spec §2.5)
# S17 — index LOCAL intra-span : rotatif contre additif contre rien
# cellule p11-locidx_locnone_m8 : bras locnone, env span, m=8 | ~47.1 M params, VRAM est. 2.11 Go
# Base = le sommet ADOPTÉ du carré factoriel : --read kv_proj --tap postnorm (S1 tranché).
# Sorties : $TB_MNT/checkpoints/toy_read_lab_p11/p11-locidx_locnone_m8/  (metrics.csv, results.json, ckpts)
set -o pipefail
export TB_ROOT="$TB_MNT"
mkdir -p "$TB_MNT/runs/toy_read_lab_p11"
python -u -m deepseek_v4_mini.toy_read_lab deepseek_v4_mini/configs/toy_read_lab_d512_p11.yaml --read kv_proj --tap postnorm --m 8 --p11-exam locidx --p11-env span --device cuda \
  2>&1 | tee $TB_MNT/runs/toy_read_lab_p11/p11-locidx_locnone_m8.log
